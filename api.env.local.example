# ─────────────────────────────────────────────────────────────────────────────
# api.env.local — node-local additions to the api service config.
#
# WHAT THIS IS FOR
# The deploy job writes ~/unpa-ci/api.env from the FLOWDESK_ENV GitHub secret,
# overwriting whatever was there. Anything configured by hand on a machine is
# therefore lost on the next deploy. Values that legitimately differ per node —
# or that were added to a node after the shared secret was last updated — belong
# in ~/unpa-ci/api.env.local, which the deploy appends AFTER the secret (later
# definitions win, so these override the secret).
#
# This file is a TEMPLATE. Copy it to the target as ~/unpa-ci/api.env.local,
# fill in real values, chmod 600. Never commit the filled-in file.
#
# Ignoring this cost a production incident: a deploy silently removed the SPA
# login gate (the form answered 503) and the FlowDesk proxy key (the chat API
# fell open to the internet). The verify job now fails the deploy if either
# invariant is broken — see .github/workflows/deploy.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ── SPA login gate ───────────────────────────────────────────────────────────
# Without these /api/v1/auth/login answers 503 and nobody can enter the SPA.
# The secret and the hash must be IDENTICAL to the ones in the local api/.env,
# or the same credential stops working across environments.
# Generate a hash: node -e "console.log(require('./src/services/auth/auth-tokens').hashPassword('PW'))"
UNPA_AUTH_SECRET=
UNPA_ADMIN_USER=unpaadmin
UNPA_ADMIN_PASSWORD_HASH=
UNPA_AUTH_ACCESS_TTL=900
UNPA_AUTH_REFRESH_TTL=604800

# ── FlowDesk proxy key ───────────────────────────────────────────────────────
# Guards /api/v1/flowdesk/* (health stays open). MUST equal Altiora's
# UnpaChat:ApiKey, and the SAME value must be in ~/unpa-ci/.env so nginx can
# inject the X-Flowdesk-Api-Key header for the same-origin SPA — otherwise
# /flowdesk-admin gets 401. Leave empty ONLY if the node should be open:
# the middleware fails OPEN when it is unset.
FLOWDESK_PROXY_API_KEY=

# ── Altiora backend ──────────────────────────────────────────────────────────
# ORIGIN ONLY — the client appends /api/... itself, so a trailing /api produces
# /api/api/... and every call 404s. The shared secret still carries the local
# dev value (http://localhost:5000), which resolves to nothing on a remote node.
ALTIORA_API_BASE=https://app-altiora-api-dev.azurewebsites.net
