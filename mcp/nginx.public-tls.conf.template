# UNPA frontend nginx — public HTTP(S) on standard ports.
#   :80  -> ACME challenge (Let's Encrypt) + redirect everything else to HTTPS
#   :443 -> SPA + reverse-proxy /api/ (HTTP, SSE and WebSocket) to the backend
# ${SERVER_NAME} and ${NGINX_API_URL} are injected at container start (envsubst).
# nginx runtime vars ($host, $uri, $http_upgrade, ...) are NOT in the env, so
# envsubst leaves them intact.

# WebSocket upgrade map (voice / streaming through /api/)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── HTTP :80 — ACME + redirect ──────────────────────────────────────────────
server {
    listen 80;
    server_name ${SERVER_NAME};

    # Let's Encrypt HTTP-01 challenge (served from the shared webroot volume)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
        try_files $uri =404;
    }

    # Everything else -> HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS :443 — app + API proxy ────────────────────────────────────────────
server {
    listen 443 ssl;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /usr/share/nginx/html;
    index index.html;

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy to the backend (same origin -> no CORS). NGINX_API_URL is the
    # internal service address http://api:3000 (== the host-published :3010).
    location /api/ {
        proxy_pass ${NGINX_API_URL}/api/;
        # The backend enforces X-Flowdesk-Api-Key on /api/v1/flowdesk/*. Inject it
        # here so the same-origin SPA never has to hold the secret. Supplied at
        # container start; an empty value sends no header.
        proxy_set_header X-Flowdesk-Api-Key "${FLOWDESK_PROXY_API_KEY}";
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_set_header Host              $proxy_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket + SSE streaming
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_buffering off;
        proxy_cache     off;
        proxy_read_timeout 300s;
    }
}
