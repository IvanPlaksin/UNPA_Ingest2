server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # SPA routing — serve index.html for all non-file paths
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy all /api/ calls to the backend API
    # NGINX_API_URL is injected at container startup via envsubst (e.g. https://unpa-api...)
    location /api/ {
        proxy_pass ${NGINX_API_URL}/api/;
        # The backend enforces X-Flowdesk-Api-Key on /api/v1/flowdesk/*. Inject it
        # here so the same-origin SPA never has to hold the secret. Supplied at
        # container start; an empty value sends no header (and the API stays open
        # only if the backend also has no key configured).
        proxy_set_header X-Flowdesk-Api-Key "${FLOWDESK_PROXY_API_KEY}";
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "";
        # SSE / streaming support
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
