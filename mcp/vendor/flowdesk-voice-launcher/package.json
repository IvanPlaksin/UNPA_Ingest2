{
  "name": "@flowdesk/voice-launcher",
  "version": "1.0.6",
  "description": "FlowDesk Voice Launcher — a round pulsing button that starts a live voice conversation with the Altiora assistant (React)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/flowdesk-voice-launcher.cjs",
  "module": "./dist/flowdesk-voice-launcher.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flowdesk-voice-launcher.js",
      "require": "./dist/flowdesk-voice-launcher.cjs"
    },
    "./styles.css": "./dist/flowdesk-voice-launcher.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "keywords": [
    "flowdesk",
    "voice",
    "assistant",
    "react"
  ]
}
