# Dependencies
**/node_modules/

# Data directories
**/data/
**/raw_data/
uploads/
**/uploads/

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
**/service-account-key.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/secrets.json

# Logs
*.log
logs/
**/logs/

# Build artifacts
**/dist/
**/coverage/
**/obj/
**/bin/
**/.vs/

# Backup files
*.bak
*.tmp

# IDE & tool caches
.claude/
.vs/
.vscode/settings.json
.vscode/mcp.json

# Docker compose (environment-specific, use .example)
docker-compose.yml

# HTTP test files (dev only)
api/ADO_req.http
api.env

# Volume backups produced by DockerScripts/backup.ps1 — hundreds of MB of
# Memgraph/Qdrant dumps. The scripts themselves are tracked; the dumps are not.
DockerScripts/backup/

# Harvested source documents (binary, tens of MB). The recon/report markdown
# next to them IS tracked.
Artefacts/Documents/
api/Artefacts/Documents/
