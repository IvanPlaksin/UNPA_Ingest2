{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FlowDeskProxy": "Debug"
    }
  },
  "AllowedHosts": "*",
  "GxeApi": {
    "BaseUrl": "http://localhost:3010",
    "TimeoutMs": 30000
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3004",
      "http://localhost:3000",
      "http://localhost:5000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "gxe-api": {
        "ClusterId": "gxe-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gxe-cluster": {
        "Destinations": {
          "gxe-api": {
            "Address": "http://localhost:3010/"
          }
        }
      }
    }
  }
}
