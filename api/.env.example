
# ── SPA Auth (login gate) ─────────────────────────────────────────────
# Protects the mcp/ SPA with a simple username/password + JWT (access+refresh).
# Generate a hash:  node -e "console.log(require('./src/services/auth/auth-tokens').hashPassword('YOUR_PASSWORD'))"
UNPA_AUTH_SECRET=change-me-to-a-long-random-hex-secret
UNPA_ADMIN_USER=unpaadmin
UNPA_ADMIN_PASSWORD_HASH=scrypt:<saltHex>:<hashHex>
UNPA_AUTH_ACCESS_TTL=900
UNPA_AUTH_REFRESH_TTL=604800
