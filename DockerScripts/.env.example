# ═══════════════════════════════════════════════════════════
# Deployment environment — copy to .env and fill in real values
#   copy .env.example .env
# ═══════════════════════════════════════════════════════════

# --- Host ports (change if already in use on the target machine) ---
REDIS_PORT=6379
MEMGRAPH_BOLT_PORT=7687
MEMGRAPH_HTTP_PORT=7444
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
API_PORT=3010
FRONTEND_PORT=5173

# --- Memgraph credentials (used by memgraph + api + backup/restore) ---
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=secret_password_123

# --- Application images (set when the app is deployed later) ---
# Either point these at pushed/loaded image tags, OR uncomment the
# build: blocks in docker-compose.yml to build from source.
API_IMAGE=projectadvisor-api:latest
FRONTEND_IMAGE=projectadvisor-frontend:latest

# --- API runtime ---
NODE_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json
CORS_ORIGINS=*
