# ═══════════════════════════════════════════════════════════
# UNPA_Ingest — Environment Variables Reference
# Copy to .env and fill in actual values before running
# ═══════════════════════════════════════════════════════════

# --- Application ---
NODE_ENV=development
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info
LOG_FORMAT=pretty

# --- CORS (comma-separated origins, required in production) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3010

# --- Security ---
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
API_KEY_ENABLED=false
API_KEY=

# --- GNN Service ---
GNN_PORT=5001
GNN_SERVICE_URL=http://localhost:5001
VITE_GNN_URL=http://localhost:5001

# --- Graph DB Backend ---
# Values: memgraph (default) | postgres-age
GRAPH_DB_BACKEND=memgraph
# Required when GRAPH_DB_BACKEND=postgres-age:
# POSTGRES_CONNECTION_STRING=postgresql://user:pass@host:5432/dbname
# POSTGRES_SSL=true            # set false if server does not support SSL
# AGE_GRAPH_NAME=unpa          # Apache AGE graph name (default: unpa)

# --- Vector DB Backend ---
# Values: qdrant (default) | pgvector
VECTOR_DB_BACKEND=qdrant
# Required when VECTOR_DB_BACKEND=pgvector (shares POSTGRES_CONNECTION_STRING above):
# VECTOR_DIM=1024              # embedding dimension (must match model output)

# --- Memgraph Configuration ---
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=your_memgraph_password_here

# Legacy Neo4j variable names (fallback — for backwards compatibility)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=memgraph
NEO4J_PASSWORD=your_memgraph_password_here

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MSSQL (SQL Server) ---
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=SqlExpress2022#Dev
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_ENCRYPT=false
FLOWDESK_MSSQL_HOST=localhost

# --- Text Embeddings (TEI / HuggingFace) ---
TEI_URL=http://localhost:8081
TEI_MODEL=intfloat/multilingual-e5-large
TEI_BATCH_SIZE=50
TEI_MAX_RETRIES=3
TEI_RETRY_DELAY_MS=1000
TEI_BATCH_DELAY_MS=100
TEI_TIMEOUT_MS=30000

# --- Ollama Configuration ---
OLLAMA_URL=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM Provider Selection ---
# Values: anthropic | azure
LLM_PROVIDER=anthropic

# --- Anthropic (direct API) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_RPM_LIMIT=50
ANTHROPIC_DAILY_TOKENS=500000
ANTHROPIC_DAILY_BUDGET=20

# --- Azure AI Foundry (production) ---
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
AZURE_MODEL_SONNET=claude-sonnet-4-20250514
AZURE_MODEL_OPUS=claude-opus-4-5
AZURE_MODEL_HAIKU=claude-haiku-4-5

# --- Azure Voice Live (Foundry AIServices + Claude Haiku 4.5 BYOM) ---
# Foundry AIServices resource (kind=AIServices) hosting the Claude deployment.
# Messages API: POST {endpoint}/anthropic/v1/messages?api-version=2026-05-01  (Authorization: Bearer {key})
AZURE_VOICE_FOUNDRY_ENDPOINT=
AZURE_VOICE_FOUNDRY_KEY=
AZURE_VOICE_DEPLOYMENT=claude-haiku-4-5
AZURE_VOICE_REGION=eastus
# Voice transport: direct = browser↔Azure WebRTC (Dev default); proxy = server-side WebSocket relay (prod)
VOICE_TRANSPORT=direct
# Active Voice Live model: haiku-byom (byom-foundry-anthropic-messages) | gpt-4o-mini (native fallback)
VOICE_LLM_MODEL=haiku-byom

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_RPM_LIMIT=60
GEMINI_DAILY_TOKENS=1000000
GEMINI_DAILY_BUDGET=10

# --- AI Usage Monitoring ---
AI_LOG_DIR=./logs/ai
AI_LOG_LEVEL=info

# --- Internal API ---
# Used by tools/agents to call back to this server
API_BASE_URL=http://localhost:3010
CODEX_API_URL=http://localhost:3010/api/v1/codex

# --- Credential Encryption (64-char hex = 32 bytes, AES-256) ---
CREDENTIAL_ENCRYPTION_KEY=your-64-char-hex-key-here-replace-before-deploy

# --- ChromaDB ---
CHROMA_PORT=8000

# --- DSPy Service ---
DSPY_SERVICE_URL=http://localhost:5001

# --- Application Logic ---
CODEX_STRICT_VALIDATION=false

# --- Background Jobs ---
ORPHAN_DETECTOR_INTERVAL_MS=21600000
TOMBSTONE_EXPIRER_INTERVAL_MS=86400000
RECORD_EXECUTION_DETAILS=false

# --- Features ---
ENABLE_WEBSOCKET=true
ENABLE_JOB_QUEUE=true
ENABLE_METRICS=true
ENABLE_SWAGGER=true

# --- FlowDesk Chat Admin (telemetry + admin section, ADMIN P0-P4) ---
# Telemetry is ON by default when FLOWDESK_CHAT_V2=true; set false to disable.
FLOWDESK_CHAT_TELEMETRY=true
# Store LLM prompt/response bodies in turn records (PII-sensitive; default off).
FLOWDESK_CHAT_LOG_PROMPTS=false
# Ratified retention for ChatSession/ChatTurn telemetry (days).
FLOWDESK_CHAT_LOG_RETENTION_DAYS=90
# Ratified inactivity window before a non-terminal session is stamped 'abandoned'.
FLOWDESK_CHAT_ABANDON_MINUTES=120
FLOWDESK_CHAT_SWEEP_INTERVAL_MINUTES=15
# Admin API access (either grants; both unset = open, with a startup warning):
# comma-separated emails/userIds from the proxy identity, or a shared header token
# (X-FlowDesk-Admin-Token) for direct Project Advisor UI access.
FLOWDESK_ADMIN_USERS=
FLOWDESK_ADMIN_TOKEN=
# ADMIN P5 — session-analysis AI agent: model for the on-demand analysis (falls
# back to FLOWDESK_LLM_MODEL, then claude-sonnet-4-6). Analysis benefits from a
# stronger model than the per-turn chat model.
FLOWDESK_ADMIN_ANALYSIS_MODEL=

# --- FlowDesk Chat V2 — form-fill gate ---
# Which gate performs the FINAL fill of a service request form, and specifically who
# resolves AUTOFILL cascade fields (the staff member's grade / duty station / appointment
# expiry that follow from an index number):
#   wizard (default) — Altiora's CreateRequestWizard resolves them from its own dictionary
#                      lookup with the user's token. The chat does NOT ask for or prefill
#                      these fields; it only gathers their filter field (the index number).
#   agent            — the AI chat resolves them itself against the dictionary (P1-12
#                      cascade). If the lookup is unavailable/empty it falls back to a plain
#                      question (the user fills the field in chat), and resolved values are
#                      carried into the form prefill.
FLOWDESK_FORM_FILL_GATE=wizard
