# --- Memgraph Configuration ---
# Note: Uses neo4j-driver (Bolt protocol compatible)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=secret_password_123

# Legacy Neo4j variable names (fallback - for backwards compatibility)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=memgraph
NEO4J_PASSWORD=secret_password_123

# --- MSSQL (SQL Server Express) ---
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=SqlExpress2022#Dev
MSSQL_TRUST_SERVER_CERTIFICATE=true

# --- Credential Encryption (64-char hex = 32 bytes, AES-256) ---
CREDENTIAL_ENCRYPTION_KEY=b21913bf45d8d5ce845726ada5032bff246de296d0b37c33a19282da48404f7e

# --- ChromaDB Configuration ---
CHROMA_PORT=8000

# --- Redis Configuration ---
REDIS_PORT=6379

# --- Application Logic ---
LOG_LEVEL=info

# --- CODEX-VALID: Schema Validation ---
# Set to 'true' to enforce strict validation on mergeNode/mergeRelationship.
# In strict mode, invalid data throws SchemaValidationError instead of warning.
CODEX_STRICT_VALIDATION=false

# --- CC-031: Background Jobs ---
# OrphanDetector: removes Qdrant vectors without Memgraph nodes (default: 6 hours)
ORPHAN_DETECTOR_INTERVAL_MS=21600000
# TombstoneExpirer: expires non-restorable tombstones (default: 24 hours)
TOMBSTONE_EXPIRER_INTERVAL_MS=86400000
# Record per-node execution details (default: false)
RECORD_EXECUTION_DETAILS=false

# --- Text Embeddings (TEI / HuggingFace) ---
TEI_URL=http://localhost:8081
TEI_MODEL=intfloat/multilingual-e5-large
TEI_BATCH_SIZE=50

# --- Ollama Configuration ---
OLLAMA_URL=http://localhost:11434
OLLAMA_API_BASE=http://localhost:11434/v1

# --- AI API Keys ---
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- AI Usage Monitoring ---
AI_LOG_DIR=./logs/ai
AI_LOG_LEVEL=info

# Rate limits (requests per minute)
GEMINI_RPM_LIMIT=60
ANTHROPIC_RPM_LIMIT=50
OLLAMA_RPM_LIMIT=100

# Daily token limits
GEMINI_DAILY_TOKENS=1000000
ANTHROPIC_DAILY_TOKENS=500000

# Daily budget limits (USD)
GEMINI_DAILY_BUDGET=10
ANTHROPIC_DAILY_BUDGET=20
