# Target Memgraph (Bolt)
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=

# Target Qdrant (REST)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Target UNPA API (catalog channel for executable graphs)
TARGET_API_URL=http://localhost:3010
TARGET_API_TOKEN=

# Optional import defaults (overridable by CLI flags)
UNPA_IMPORT_CONFLICT=skip
UNPA_IMPORT_BATCH_SIZE=1000
UNPA_IMPORT_CATALOG_CHANNEL=refuse
